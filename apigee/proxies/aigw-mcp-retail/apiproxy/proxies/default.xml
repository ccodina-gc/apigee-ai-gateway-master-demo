<ProxyEndpoint name="default">
  <Description>MCP Discovery Proxy: Apigee exposes the Cymbal Retail API operations as MCP tools.</Description>
  <FaultRules>
    <FaultRule name="tool-quota">
      <Step>
        <Name>AM-Err-McpQuota</Name>
      </Step>
      <Condition>fault.name = "QuotaViolation"</Condition>
    </FaultRule>
  </FaultRules>
  <DefaultFaultRule name="default-fault">
    <Step>
      <Name>AM-Err-McpParse</Name>
      <Condition>(fault.name = "InvalidJson") or (parsepayload.PP-ParseMcp.failed = true)</Condition>
    </Step>
    <Step>
      <Name>AM-Err-McpForbidden</Name>
      <Condition>fault.name = "InvalidApiKeyForGivenResource"</Condition>
    </Step>
    <Step>
      <Name>AM-Err-McpUnauthorized</Name>
      <Condition>(verifyapikey.VA-VerifyAPIKey.failed = true) and (fault.name != "InvalidApiKeyForGivenResource")</Condition>
    </Step>
    <Step>
      <Name>JS-Finalize</Name>
    </Step>
    <AlwaysEnforce>true</AlwaysEnforce>
  </DefaultFaultRule>
  <PreFlow name="PreFlow">
      <Request>
        <Step>
          <Name>RF-MethodNotAllowed</Name>
          <Condition>request.verb != "POST"</Condition>
        </Step>
        <Step>
          <Name>PP-ParseMcp</Name>
        </Step>
        <Step>
          <Name>VA-VerifyAPIKey</Name>
          <Condition>(parsepayload.PP-ParseMcp.json-rpc.request.method != "initialize") and (parsepayload.PP-ParseMcp.json-rpc.request.method != "ping") and NOT (parsepayload.PP-ParseMcp.json-rpc.request.method =| "notifications/")</Condition>
        </Step>
        <Step>
          <Name>Q-McpToolQuota</Name>
          <Condition>verifyapikey.VA-VerifyAPIKey.client_id != null</Condition>
        </Step>
        <Step>
          <Name>AM-CleanRequest</Name>
        </Step>
      </Request>
      <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
      <Request/>
      <Response>
        <Step>
          <Name>JS-Finalize</Name>
        </Step>
      </Response>
  </PostFlow>
  <PostClientFlow>
    <Response>
        <Step>
          <Name>ML-Log</Name>
        </Step>
    </Response>
  </PostClientFlow>
  <HTTPProxyConnection>
    <BasePath>/mcp</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
