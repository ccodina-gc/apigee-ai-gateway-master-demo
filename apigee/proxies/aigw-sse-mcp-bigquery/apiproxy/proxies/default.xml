<ProxyEndpoint name="default">
  <Description>SSE streaming + remote BigQuery MCP server through Apigee.</Description>
  <FaultRules>
    <FaultRule name="tool-quota">
      <Step>
        <Name>AM-Err-McpQuota</Name>
      </Step>
      <Condition>fault.name = "QuotaViolation"</Condition>
    </FaultRule>
  </FaultRules>
  <DefaultFaultRule name="default-fault">
    <Step>
      <Name>AM-Err-McpParse</Name>
      <Condition>((fault.name = "InvalidJson") or (parsepayload.PP-ParseMcp.failed = true)) and (proxy.pathsuffix MatchesPath "/mcp/bigquery")</Condition>
    </Step>
    <Step>
      <Name>AM-Err-McpForbidden</Name>
      <Condition>(fault.name = "InvalidApiKeyForGivenResource") and (proxy.pathsuffix MatchesPath "/mcp/bigquery")</Condition>
    </Step>
    <Step>
      <Name>AM-Err-McpUnauthorized</Name>
      <Condition>(verifyapikey.VA-VerifyAPIKey.failed = true) and (fault.name != "InvalidApiKeyForGivenResource") and (proxy.pathsuffix MatchesPath "/mcp/bigquery")</Condition>
    </Step>
    <Step>
      <Name>AM-Err-Unauthorized</Name>
      <Condition>(verifyapikey.VA-VerifyAPIKey.failed = true) and (proxy.pathsuffix MatchesPath "/chat/completions")</Condition>
    </Step>
    <Step>
      <Name>JS-Finalize</Name>
    </Step>
    <AlwaysEnforce>true</AlwaysEnforce>
  </DefaultFaultRule>
  <PreFlow name="PreFlow">
      <Request>
        <Step>
          <Name>RF-MethodNotAllowed</Name>
          <Condition>request.verb != "POST"</Condition>
        </Step>
      </Request>
      <Response/>
  </PreFlow>
  <Flows>
    <Flow name="mcp-bigquery">
      <Description>Remote BigQuery MCP server (Streamable HTTP)</Description>
      <Request>
        <Step>
          <Name>PP-ParseMcp</Name>
        </Step>
        <Step>
          <Name>VA-VerifyAPIKey</Name>
          <Condition>(parsepayload.PP-ParseMcp.json-rpc.request.method != "initialize") and (parsepayload.PP-ParseMcp.json-rpc.request.method != "ping") and NOT (parsepayload.PP-ParseMcp.json-rpc.request.method =| "notifications/")</Condition>
        </Step>
        <Step>
          <Name>Q-McpToolQuota</Name>
          <Condition>verifyapikey.VA-VerifyAPIKey.client_id != null</Condition>
        </Step>
      </Request>
      <Response/>
      <Condition>proxy.pathsuffix MatchesPath "/mcp/bigquery"</Condition>
    </Flow>
    <Flow name="chat-stream">
      <Description>Gemini streaming (Server-Sent Events)</Description>
      <Request>
        <Step>
          <Name>VA-VerifyAPIKey</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>proxy.pathsuffix MatchesPath "/chat/completions"</Condition>
    </Flow>
    <Flow name="not-found">
      <Request>
        <Step>
          <Name>RF-NotFound</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
      <Request/>
      <Response>
        <Step>
          <Name>JS-Finalize</Name>
        </Step>
      </Response>
  </PostFlow>
  <PostClientFlow>
    <Response>
        <Step>
          <Name>ML-Log</Name>
        </Step>
    </Response>
  </PostClientFlow>
  <HTTPProxyConnection>
    <BasePath>/v1/aigw/sse</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="bigquery">
    <TargetEndpoint>bigquery</TargetEndpoint>
    <Condition>proxy.pathsuffix MatchesPath "/mcp/bigquery"</Condition>
  </RouteRule>
  <RouteRule name="llm">
    <TargetEndpoint>llm-stream</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
